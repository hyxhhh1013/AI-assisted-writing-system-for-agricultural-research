// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户模型
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  password  String    // bcrypt hash
  role      String    @default("user") // "user" | "admin"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  projects  Project[]
}

// 论文项目模型
model Project {
  id                String    @id @default(cuid())
  title             String
  userId            String
  authors           String?   @default("Lab Member")
  affiliations      String?   @default("农业科学研究中心，北京 100083")
  abstract          String?   @default("")
  keywords          String?   @default("")
  classification    String?   @default("")
  researchDirection String?   @default("")
  outline           String?   @default("")
  template          String    @default("sci") // 'sci' | 'ieee' | 'gbt7713' | 'nature'
  lastUpdated       DateTime  @updatedAt
  createdAt         DateTime  @default(now())

  // 关联用户
  owner             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 章节内容
  sections          Section[]
  // 参考文献
  references        Reference[]
  // 分析结果 (存储为 JSON 或 关联表)
  analysisResults   AnalysisResult[]
  // 查重检测
  plagiarismChecks  PlagiarismCheck[]
  // 引用-文献映射
  referenceSources  ReferenceSource[]
  // 写作模式
  mode              String?   @default("review") // "review" | "research"
  // 图表元数据（JSON 字符串）
  charts            String?
  // 数据证据声明（JSON 数组 EvidenceClaim[]）
  dataClaims        String?
  // 引用格式标准（gbt7714 | vancouver | apa7 | ieee）
  citationStyle     String?   @default("gbt7714")
  // 数据源分析结果（JSON 数组 DataSourceAnalysis[]）
  dataSources       String?

  @@index([userId])
}

// 章节模型
model Section {
  id        String   @id @default(cuid())
  key       String   // 'introduction', 'methods', 'results', 'conclusion'
  content   String   @default("")
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
}

// 参考文献模型
model Reference {
  id        String   @id @default(cuid())
  content   String
  order     Int      @default(0)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

// 分析结果模型
model AnalysisResult {
  id        String   @id @default(cuid())
  content   String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// 知识库文献模型 (用于同步文件系统和数据库)
model KnowledgeFile {
  id           String   @id @default(cuid())
  name         String   @unique
  category     String   @default("未分类")
  documentType String   @default("paper") // "paper" | "patent" | "other"
  size         Int
  mtime        DateTime?
  bib          String?  // JSON string of KnowledgeBib
  gbTag        String?
  parseWarning String?  // "no_text" | "low_text" | null
  bibEdited    Boolean  @default(false)
  chunkCount   Int      @default(0) // RAG index_*.json 块数，非 KnowledgeChunk 行数
  chunks       KnowledgeChunk[]
}

// 知识库分块模型 (存储向量 RAG 信息)
model KnowledgeChunk {
  id        String   @id @default(cuid())
  content   String
  embedding String?  // 存储为 JSON 字符串，因为 SQLite 不直接支持向量类型
  fileId    String
  file      KnowledgeFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
}

// ==================== 查重功能模型 ====================

// 查重检测会话
model PlagiarismCheck {
  id            String             @id @default(cuid())
  projectId     String?            // 关联项目（可选）
  title         String             // 检测标题
  content       String             // 检测内容全文
  status        String             @default("pending") // pending | processing | completed | failed
  maxSimilarity Float              @default(0)
  overallRisk   String             @default("low") // high | medium | low
  createdAt     DateTime           @default(now())
  completedAt   DateTime?

  project     Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  matches     PlagiarismMatch[]
  rewrites    RewriteSuggestion[]

  @@index([projectId])
}

// 查重匹配结果
model PlagiarismMatch {
  id           String   @id @default(cuid())
  checkId      String
  check        PlagiarismCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)

  // 原文段落
  sourceText   String           // 论文中匹配的原文段落
  sourceOffset Int              // 在原文中的起始位置

  // 匹配来源
  matchType    String           // local（本地库）| web（联网）| cross（项目间）
  matchedText  String           // 匹配到的外部文本
  matchedFrom  String           // 来源名称（论文标题/URL）
  matchedUrl   String?          // 来源链接

  similarity   Float            // 相似度 0-1
  riskLevel    String           // high | medium | low
  createdAt    DateTime         @default(now())
  rewrites     RewriteSuggestion[]

  @@index([checkId])
}

// 降重改写建议
model RewriteSuggestion {
  id          String   @id @default(cuid())
  checkId     String
  check       PlagiarismCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  matchId     String?
  match       PlagiarismMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)

  originalText String            // 原文
  suggestedText String           // 改写建议
  strategy     String            // synonym（同义替换）| rephrase（改写语序）| summarize（概括）| expand（扩写）
  status       String            @default("pending") // pending | accepted | rejected
  rewrittenSimilarity Float?     // 改写后预期相似度
  createdAt    DateTime          @default(now())

  @@index([checkId])
}

// ==================== 引用-文献映射 ====================

// ==================== 论文审查模型 ====================

model ReviewCheck {
  id            String   @id @default(cuid())
  projectId     String?
  title         String
  content       String   // 审查的完整文本
  status        String   @default("pending") // pending | running | done | failed
  overallScore  Float?
  overallGrade  String?  // A/B/C/D
  summary       String?  // 总体评价
  synopsis      String?  // 论文概要
  dimensions    String?  // JSON: 各维度得分和统计
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  issues        ReviewIssue[]

  @@index([projectId])
  @@index([createdAt])
}

model ReviewIssue {
  id          String   @id @default(cuid())
  checkId     String
  check       ReviewCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)

  dimension   String   // "academic" | "argument" | "structure" | "integrity"
  type        String   // 具体问题类型
  severity    String   // "high" | "medium" | "low"
  location    String?  // 问题所在位置
  evidence    String?  // 证据锚点
  description String   // 问题描述
  suggestion  String?  // 改进建议
  originalText String? // 原文片段

  status      String   @default("open")  // open | fixing | fixed | dismissed
  fixedContent String? // AI 修复后的内容
  createdAt   DateTime @default(now())

  @@index([checkId])
  @@index([dimension])
  @@index([severity])
}

// 论文中 [N] 引用编号到知识库文献源的映射，用于前端溯源查看原文
model ReferenceSource {
  id            String   @id @default(cuid())
  projectId     String
  refIndex      Int      // 引用编号 [1], [2]...
  sourceName    String   // RAG 源文件名（如 "2023_Zhang_et_al.pdf"）
  category      String   // 文献分类
  citation      String   // 格式化引用文字
  createdAt     DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@unique([projectId, refIndex])
}

// 系统设置（加密 key-value 存储）
model SystemSetting {
  key       String   @id
  value     String   // AES-256-GCM 加密
  updatedAt DateTime @updatedAt
}
