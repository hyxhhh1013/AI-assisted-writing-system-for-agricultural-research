# AI API Configuration
# 推荐使用 DeepSeek API（性价比极高）
# 复制此文件为 .env.local 并填入你的 Key
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# 智谱 AI (GLM) 配置 — 可选，用于 Verifier 独立验证（与 Writer 使用不同模型）
# 在 https://open.bigmodel.cn/ 获取 API Key
# ZHIPU_API_KEY=your_zhipu_api_key_here
# ZHIPU_MODEL=glm-4-plus       # 可选，默认为 glm-4-plus
