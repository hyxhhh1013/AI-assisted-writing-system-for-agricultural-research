# ============================================================
# 禾书耕文 (GrainScript) — 环境变量模板
# 复制为 .env 并填入真实值；.env 已在 .gitignore 中，不会上传
# ============================================================

# ---- 数据库 ----
# SQLite 路径（本地开发）
DATABASE_URL=file:./prisma/dev.db

# ---- 认证 ----
# JWT 签名密钥，生产环境请用随机长字符串：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# ---- AI 模型 ----
# DeepSeek API Key（主写作 / Refiner agent）
# 申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 智谱 GLM-4-plus（Verifier agent，可选）
# 申请：https://open.bigmodel.cn/
# 不填则 Verifier 自动降级为 DeepSeek
ZHIPU_API_KEY=

# ---- RAG 向量嵌入（可选） ----
# 默认使用 DeepSeek Embeddings，如需替换：
# RAG_EMBEDDINGS_URL=https://your-embedding-endpoint/v1/embeddings
# RAG_EMBEDDING_MODEL=your-embedding-model
# RAG_EMBEDDING_API_KEY=your-embedding-key

# ---- Python 图表生成 ----
# 系统 Python 路径，需要 matplotlib / numpy 等依赖
# Windows: python  |  Linux/Mac: python3
PYTHON_CMD=python

# ---- 功能开关（可选，默认全部开启） ----
# 设为 "false" 即关闭对应功能入口
# NEXT_PUBLIC_ENABLE_WRITING=true
# NEXT_PUBLIC_ENABLE_OUTLINE=true
# NEXT_PUBLIC_ENABLE_ANALYSIS=true
# NEXT_PUBLIC_ENABLE_TRANSLATE=true
# NEXT_PUBLIC_ENABLE_PLAGIARISM=true
# NEXT_PUBLIC_ENABLE_CHART=true
# NEXT_PUBLIC_ENABLE_KNOWLEDGE=true
# NEXT_PUBLIC_ENABLE_CONSISTENCY=true
# NEXT_PUBLIC_ENABLE_XRD=true
# NEXT_PUBLIC_ENABLE_PDF=true

# ---- 开发调试（仅本地） ----
# 设为 "1" 时跳过 JWT 验证，注入硬编码 userId（生产绝对不要设）
# AUTH_BYPASS=1
