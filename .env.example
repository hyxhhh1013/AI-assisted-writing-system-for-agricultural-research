# 数据库
DATABASE_URL=file:./prisma/dev.db

# AI API Configuration
# 推荐使用 DeepSeek API（性价比极高）
# 复制此文件为 .env 并填入你的 Key
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# 智谱 AI (GLM) 配置 — 可选，用于 Verifier 独立验证（与 Writer 使用不同模型）
# 在 https://open.bigmodel.cn/ 获取 API Key
# ZHIPU_API_KEY=your_zhipu_api_key_here
# ZHIPU_MODEL=glm-4-plus       # 可选，默认为 glm-4-plus

# JWT 密钥（用于用户认证，生产环境请使用随机字符串）
# 生成方式：openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here

# Python 命令路径（图表生成用，默认 Windows: python, Linux: python3）
# PYTHON_CMD=python3
