# ============================================================
# 禾书耕文 (GrainScript) — 环境变量模板
# 复制为 .env 并填入真实值；.env 已在 .gitignore 中，不会上传
# ============================================================

# ---- 数据库 ----
# 本地开发：本机 PostgreSQL（本仓库默认端口 5433；若你改过端口请同步修改）
# VPS PM2：用 127.0.0.1:5432（见 docs/DEPLOY_SETUP_CHECKLIST.md）
DATABASE_URL=postgresql://grainscript:grainscript_dev_2024@localhost:5433/grainscript

# ---- 认证 ----
# JWT 签名密钥，生产环境请用随机长字符串：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# ---- AI 模型 ----
# DeepSeek API Key（主写作 / Refiner agent）
# 申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 智谱 GLM-4-plus（Verifier agent，可选）
# 申请：https://open.bigmodel.cn/
# 不填则 Verifier 自动降级为 DeepSeek
ZHIPU_API_KEY=

# ---- 多 API Key 轮转（可选，缓解上游按 Key 限流 429）----
# 代码在 src/lib/ai.ts 中按次轮转；命名须带数字后缀，最多 _10。
# 注意：多 Key 抬高厂商配额，不能替代 VPS 内存/CPU 限流（见 ENG-PR-087）。
# DEEPSEEK_API_KEY_2=sk-xxxxxxxx
# DEEPSEEK_API_KEY_3=sk-xxxxxxxx
# ZHIPU_API_KEY_2=
# 亦可在 Admin → 设置 中新增同名键（DB 存储，约 30s 热加载）。

# ---- RAG 向量嵌入（可选，DeepSeek 无 embedding 接口） ----
# 不配置则索引仍可完成，检索降级为 BM25 关键词匹配
# 智谱示例（需单独申请 ZHIPU_API_KEY）：
# RAG_EMBEDDINGS_URL=https://open.bigmodel.cn/api/paas/v4/embeddings
# RAG_EMBEDDING_MODEL=embedding-3
# RAG_EMBEDDING_API_KEY=your_zhipu_api_key

# PDF 文献目录（相对项目根；VPS 生产建议绝对路径，如 /home/ubuntu/grainscript/papers）
RAG_ARTICLES_DIR=papers

# ---- Python 图表生成 ----
# Linux/macOS 常用 python3；Windows 本地开发可改为 python
PYTHON_CMD=python3
# 运行时数据根（可选）。不设则用仓库根。
# 本地若用 `node .next/standalone/server.js` 且 cwd 在 .next 内，设成仓库根可避免图写进 .next 后被 rebuild 清掉
# GRAINSCRIPT_DATA_ROOT=D:\project\论文助手

# ---- 功能开关（可选，默认全部开启） ----
# 设为 "false" 即关闭对应功能入口
# NEXT_PUBLIC_ENABLE_WRITING=true
# NEXT_PUBLIC_ENABLE_OUTLINE=true
# NEXT_PUBLIC_ENABLE_ANALYSIS=true
# NEXT_PUBLIC_ENABLE_TRANSLATE=true
# NEXT_PUBLIC_ENABLE_PLAGIARISM=true
# NEXT_PUBLIC_ENABLE_CHART=true
# NEXT_PUBLIC_ENABLE_KNOWLEDGE=true
# NEXT_PUBLIC_ENABLE_CONSISTENCY=true
# NEXT_PUBLIC_ENABLE_XRD=true
# NEXT_PUBLIC_ENABLE_PDF=true

# ---- E2E 冒烟（npm run test:e2e，需 PostgreSQL + create-admin） ----
# E2E_EMAIL=admin@lab.local
# E2E_PASSWORD=admin123456
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# ---- 文献库期刊指标（ENG-PR-091，可选） ----
# OpenAlex 礼貌池；填实验室邮箱可提升限速额度
# OPENALEX_MAILTO=lab@example.edu
# 默认期刊表路径（node scripts/import-journal-metrics.mjs 无参数时使用，支持 .csv/.xlsx）
# JOURNAL_METRICS_CSV_PATH=data/journal-metrics.csv
# 索引完成后自动 OpenAlex 补被引/ISSN（或 index-pdfs --enrich-metrics）
# ENRICH_OPENALEX_AFTER_INDEX=true

# ---- 扩写管道并发（ENG-PR-087，8GB VPS 建议保持默认） ----
# 全站同时执行的写作管道上限；超限时排队等待（WRITING_QUEUE_WAIT_MS），超时才提示「繁忙稍后再试」
WRITING_MAX_CONCURRENT=2
# 并发满时排队等待写槽的最长毫秒数；超时后 Agent 收到友好「繁忙」提示
WRITING_QUEUE_WAIT_MS=60000
# Verifier 阶段加载引用全文的上限；0=跳过全文加载
WRITING_VERIFIER_MAX_FULL_SOURCES=5
# UI 默认扩写模式（fast|full）；生产建议 fast
WRITING_DEFAULT_MODE=fast

# ---- AI Agent（Wave 2；默认关闭） ----
# 服务端启用 POST /api/agent
# AGENT_ENABLED=1
# 工作台显示 Agent Tab（/academic-paper 引导页依赖此开关）
# NEXT_PUBLIC_AGENT_ENABLED=1
# 允许 Agent 写回章节（write_section / refine）；只读对话可不设
# AGENT_WRITE_ENABLED=1
# 前端展示「可写回」快捷语与提示（须与 AGENT_WRITE_ENABLED 同时开）
# NEXT_PUBLIC_AGENT_WRITE_ENABLED=1
# Agent 写章节后自动 Verifier+Refiner 一轮（ENG-PR-082 / W3-AUTO-FIX；设 0 关闭）
# AGENT_WRITE_AUTO_FIX=1
# 文献导入被引数下限（0=关闭；设置后低于此值的文献需 why≥8字 说明才可导入，批量会过滤低被引）
# MIN_IMPORT_CITEDBY=0
# 调试：允许绕过导出引用硬检（切勿在生产开启）
# EXPORT_FORCE_BYPASS=1

# ---- 开发调试（仅本地，生产禁止） ----
# 设为 "true" 时跳过 JWT，向 request 注入固定 userId；NODE_ENV=production 时自动忽略
# AUTH_BYPASS=true
# 允许绕过 PDF/导出引用硬检（切勿在生产开启）
# EXPORT_FORCE_BYPASS=1
