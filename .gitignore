# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# runtime data
/data/*
# 静态 XRD 参考数据（峰位表）供测试与运行时使用，需进仓库
!/data/xrd/
!/data/xrd/phase-reference.json
prisma/dev.db
prisma/dev.db-journal
prisma/dev.db-shm
prisma/dev.db-wal
# 嵌套 dev.db（早期遗漏，2026-08-06 清理）
prisma/prisma/dev.db
prisma/prisma/dev.db-journal
prisma/prisma/dev.db-shm
prisma/prisma/dev.db-wal

# python
__pycache__/

# PDF knowledge base (large binaries)
/papers/
/temp/

# Deploy output
deploy/grainscript-deploy/
deploy/grainscript-deploy.zip
deploy-pkg/
deploy.tar.gz

# Generated temp files
.tmp/

# Agent attachments (W3-FILE-UPLOAD)
data/attachments/

# Backup files
backup_*
.gstack/
grainscript_recover.sql

# 生成物 / 临时导出（.md 与 .py 脚本才是源）
docs/_pdf_export_*
禾书耕文-演示.html

# bun 锁文件（项目用 npm，勿提交）
bun.lock
