    {
      "id": "table",
      "name": "表格",
      "icon": "Table2",
      "order": 5
    }
  ],
  "global_style_fields": [
    {
      "key": "preset",
      "label": "期刊风格",
      "type": "select",
      "group": "style",
      "display": "visible",
