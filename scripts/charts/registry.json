    {
      "key": "fig_width",
      "label": "图片宽度 (inch，空则按栏宽)",
      "type": "number",
      "group": "style",
      "display": "advanced",
      "default": 3.5,
      "min": 2,
      "max": 14,
      "step": 0.05
