{
  "version": "2.0",
  "description": "禾书耕文 — 科学图形统一注册表。加新图形类型只需在此文件加一条记录。",
  "categories": [
    {"id": "chart", "name": "数据图表", "icon": "BarChart3", "order": 1},
    {"id": "diagram", "name": "示意图", "icon": "Workflow", "order": 2},
    {"id": "xrd", "name": "XRD 分析", "icon": "Radar", "order": 3},
    {"id": "table", "name": "表格", "icon": "Table2", "order": 4}
  ],
  "global_style_fields": [
    {"key": "preset", "label": "期刊预设", "type": "select", "group": "style", "default": "nature", "options": ["nature", "agr_journal", "slide"]},
    {"key": "palette", "label": "配色方案", "type": "select", "group": "style", "default": "nature", "options": ["nature", "agr", "pastel"]},
    {"key": "fig_width", "label": "图宽 (inch)", "type": "number", "group": "style", "default": 3.5, "min": 2, "max": 14, "step": 0.5},
    {"key": "fig_height", "label": "图高 (inch)", "type": "number", "group": "style", "default": 2.5, "min": 2, "max": 10, "step": 0.5},
    {"key": "font_size", "label": "字号 (pt)", "type": "number", "group": "style", "default": 8, "min": 6, "max": 18, "step": 1},
    {"key": "dpi", "label": "导出 DPI", "type": "number", "group": "style", "default": 600, "min": 150, "max": 600, "step": 50},
    {"key": "panel_label", "label": "子图标注 (a/b/c)", "type": "text", "group": "style", "default": ""},
    {"key": "legend_loc", "label": "图例位置", "type": "select", "group": "style", "default": "best", "options": ["best", "upper right", "upper left", "lower right", "lower left", "center left", "center right"]},
    {"key": "show_grid", "label": "显示网格", "type": "boolean", "group": "style", "default": false},
    {"key": "legend_frame", "label": "图例边框", "type": "boolean", "group": "style", "default": false},
    {"key": "show_values", "label": "柱顶数值", "type": "boolean", "group": "style", "default": false},
    {"key": "bar_edge", "label": "柱边框 (Nature)", "type": "boolean", "group": "style", "default": true},
    {"key": "export_formats", "label": "导出格式", "type": "select", "group": "style", "default": "png,svg", "options": ["png,svg", "png,svg,pdf", "png,pdf", "png"]},
    {"key": "axes_linewidth", "label": "轴线粗细", "type": "number", "group": "advanced", "default": 0.8, "min": 0.5, "max": 3, "step": 0.1},
    {"key": "x_tick_rotation", "label": "X 刻度旋转 (°)", "type": "number", "group": "advanced", "default": 0, "min": 0, "max": 90, "step": 5},
    {"key": "y_sci_notation", "label": "Y 轴科学计数法", "type": "boolean", "group": "advanced", "default": false}
  ],
  "figures": [
    {
      "id": "bar_grouped",
      "name": "分组柱状图",
      "category": "chart",
      "description": "多组数据并列对比，X 轴为分类，每个分类下多个柱子",
      "endpoint": "/api/chart",
      "input_type": "tabular",
      "example": "温度,N₂产率,CO₂产率\n500,44,44\n600,35,32\n700,30,30",
      "config_fields": [
        {"key": "title", "label": "图表标题", "type": "text"},
        {"key": "x_label", "label": "X 轴标签", "type": "text"},
        {"key": "y_label", "label": "Y 轴标签", "type": "text"},
        {"key": "y_log_scale", "label": "Y 轴对数刻度", "type": "boolean", "default": false}
      ]
    },
    {
      "id": "bar_stacked",
      "name": "堆积柱状图",
      "category": "chart",
      "description": "展示各部分绝对值的堆叠构成",
      "endpoint": "/api/chart",
      "input_type": "tabular",
      "example": "样品,组分A,组分B,组分C\nS1,20,30,50\nS2,25,35,40",
      "config_fields": [
        {"key": "title", "label": "图表标题", "type": "text"},
        {"key": "x_label", "label": "X 轴标签", "type": "text"},
        {"key": "y_label", "label": "Y 轴标签", "type": "text"}
      ]
    },
    {
      "id": "bar_pct_stacked",
      "name": "百分比堆积柱状图",
      "category": "chart",
      "description": "各部分相对比例变化，自动归一化到 100%",
      "endpoint": "/api/chart",
      "input_type": "tabular",
      "example": "条件,Pyridinic-N,Pyrrolic-N,Quaternary-N\n300N₂,35,40,25\n500N₂,25,35,40",
      "config_fields": [
        {"key": "title", "label": "图表标题", "type": "text"},
        {"key": "x_label", "label": "X 轴标签", "type": "text"}
      ]
    },
    {
      "id": "line",
      "name": "折线图",
      "category": "chart",
      "description": "展示数值随变量变化的连续趋势",
      "endpoint": "/api/chart",
      "input_type": "tabular",
      "example": "时间,处理A,处理B,对照\n0,10,10,10\n7,15,12,11\n14,22,16,12",
      "config_fields": [
        {"key": "title", "label": "图表标题", "type": "text"},
        {"key": "x_label", "label": "X 轴标签", "type": "text"},
        {"key": "y_label", "label": "Y 轴标签", "type": "text"},
        {"key": "show_shadow", "label": "误差阴影带", "type": "boolean", "default": false, "group": "advanced"}
      ]
    },
    {
      "id": "scatter",
      "name": "散点图",
      "category": "chart",
      "description": "展示两个变量之间的相关关系",
      "endpoint": "/api/chart",
      "input_type": "tabular",
      "example": "温度,产率\n25,45\n30,52\n35,58\n40,55\n45,48",
      "config_fields": [
        {"key": "title", "label": "图表标题", "type": "text"},
        {"key": "x_label", "label": "X 轴标签", "type": "text"},
        {"key": "y_label", "label": "Y 轴标签", "type": "text"},
        {"key": "show_trendline", "label": "线性趋势线", "type": "boolean", "default": false, "group": "advanced"}
      ]
    },
    {
      "id": "pie",
      "name": "饼图",
      "category": "chart",
      "description": "展示各分类占总体的百分比",
      "endpoint": "/api/chart",
      "input_type": "tabular",
      "example": "组分,比例\n生物炭,35\n生物油,30\n热解气,35",
      "config_fields": [
        {"key": "title", "label": "图表标题", "type": "text"}
      ]
    },
    {
      "id": "heatmap",
      "name": "热力图",
      "category": "chart",
      "description": "矩阵热力图，适合相关矩阵、基因表达、处理×指标对比",
      "endpoint": "/api/chart",
      "input_type": "tabular",
      "example": "指标,处理A,处理B,处理C\n叶绿素,0.82,0.65,0.71\n株高,0.45,0.88,0.62\n产量,0.55,0.72,0.91",
      "config_fields": [
        {"key": "title", "label": "图表标题", "type": "text"},
        {"key": "x_label", "label": "X 轴标签", "type": "text"},
        {"key": "y_label", "label": "色标标签", "type": "text"},
        {"key": "cmap", "label": "配色", "type": "select", "default": "YlGnBu", "options": ["YlGnBu", "magma", "viridis", "RdYlGn", "coolwarm"]},
        {"key": "heatmap_annotate", "label": "格内标注数值", "type": "boolean", "default": true}
      ]
    },
    {
      "id": "area",
      "name": "面积图",
      "category": "chart",
      "description": "堆叠或分层面积趋势，适合时序累积、组分变化",
      "endpoint": "/api/chart",
      "input_type": "tabular",
      "example": "年份,生物炭,生物油,热解气\n2020,10,8,5\n2021,18,12,9\n2022,25,15,12\n2023,32,18,15",
      "config_fields": [
        {"key": "title", "label": "图表标题", "type": "text"},
        {"key": "x_label", "label": "X 轴标签", "type": "text"},
        {"key": "y_label", "label": "Y 轴标签", "type": "text"},
        {"key": "area_stacked", "label": "堆叠面积", "type": "boolean", "default": true}
      ]
    },
    {
      "id": "forest",
      "name": "森林图",
      "category": "chart",
      "description": "效应量与置信区间，适合 Meta 分析、亚组效应",
      "endpoint": "/api/chart",
      "input_type": "tabular",
      "example": "研究,估计值,CI下限,CI上限\n试验A,0.65,0.42,0.88\n试验B,0.48,0.22,0.74\n试验C,0.72,0.55,0.89",
      "config_fields": [
        {"key": "title", "label": "图表标题", "type": "text"},
        {"key": "x_label", "label": "X 轴标签", "type": "text", "default": "效应量"},
        {"key": "forest_ref", "label": "参考线 (无效线)", "type": "number", "default": 0}
      ]
    },
    {
      "id": "radar",
      "name": "雷达图",
      "category": "chart",
      "description": "多指标多维对比，适合方法/品种综合评价",
      "endpoint": "/api/chart",
      "input_type": "tabular",
      "example": "指标,品种A,品种B,品种C\n产量,85,72,90\n抗病性,70,88,65\n品质,78,80,82\n耐旱性,60,75,68",
      "config_fields": [
        {"key": "title", "label": "图表标题", "type": "text"}
      ]
    },
    {
      "id": "flow",
      "name": "流程图 / 机理图",
      "category": "diagram",
      "description": "绘制实验流程图或反应机理图，节点 + 连线",
      "endpoint": "/api/flow-diagram",
      "input_type": "json",
      "example": "{\"nodes\":[{\"id\":\"1\",\"label\":\"原料预处理\"},{\"id\":\"2\",\"label\":\"热解反应\"},{\"id\":\"3\",\"label\":\"产物收集\"}],\"edges\":[{\"from\":\"1\",\"to\":\"2\"},{\"from\":\"2\",\"to\":\"3\"}]}",
      "config_fields": [
        {"key": "title", "label": "图标题", "type": "text"},
        {"key": "direction", "label": "方向", "type": "select", "options": ["vertical", "horizontal"]}
      ]
    },
    {
      "id": "molecule",
      "name": "分子结构图",
      "category": "diagram",
      "description": "从 SMILES 表达式生成分子结构图",
      "endpoint": "/api/mol-diagram",
      "input_type": "json",
      "example": "{\"smiles\":\"CC(=O)OC1=CC=CC=C1C(=O)O\",\"label\":\"阿司匹林\"}",
      "config_fields": [
        {"key": "smiles", "label": "SMILES 表达式", "type": "text"},
        {"key": "label", "label": "分子名称", "type": "text"}
      ]
    },
    {
      "id": "xrd_peakfit",
      "name": "XRD 峰拟合",
      "category": "xrd",
      "description": "XRD 图谱峰分解 + 背景扣除",
      "endpoint": "/api/xrd/peakfit",
      "input_type": "form",
      "config_fields": [
        {"key": "title", "label": "图标题", "type": "text"}
      ]
    },
    {
      "id": "xrd_unitcell",
      "name": "晶胞可视化",
      "category": "xrd",
      "description": "3D 晶胞结构可视化",
      "endpoint": "/api/xrd/unitcell",
      "input_type": "json",
      "example": "{\"a\":5.4,\"b\":5.4,\"c\":5.4,\"alpha\":90,\"beta\":90,\"gamma\":90}",
      "config_fields": [
        {"key": "title", "label": "图标题", "type": "text"}
      ]
    },
    {
      "id": "xrd_amorphous",
      "name": "XRD 非晶分析",
      "category": "xrd",
      "description": "非晶态 XRD 图谱分析",
      "endpoint": "/api/xrd/amorphous",
      "input_type": "form",
      "config_fields": [
        {"key": "title", "label": "图标题", "type": "text"}
      ]
    },
    {
      "id": "xrd_bragg",
      "name": "Bragg 方程计算器",
      "category": "xrd",
      "description": "Bragg 方程参数计算与可视化",
      "endpoint": "/api/xrd/bragg",
      "input_type": "json",
      "example": "{\"wavelength\":1.5406,\"two_theta\":[20,30,40]}",
      "config_fields": [
        {"key": "wavelength", "label": "波长 (Å)", "type": "text"}
      ]
    },
    {
      "id": "xrd_simulate",
      "name": "XRD 图谱模拟",
      "category": "xrd",
      "description": "从晶体结构模拟 XRD 图谱",
      "endpoint": "/api/xrd/simulate",
      "input_type": "json",
      "config_fields": [
        {"key": "title", "label": "图标题", "type": "text"}
      ]
    },
    {
      "id": "xrd_xps",
      "name": "XPS 分析",
      "category": "xrd",
      "description": "XPS 光谱分析与峰拟合",
      "endpoint": "/api/xrd/xps",
      "input_type": "form",
      "config_fields": [
        {"key": "title", "label": "图标题", "type": "text"}
      ]
    },
    {
      "id": "table_three_line",
      "name": "三线表 (GB/T 7714)",
      "category": "table",
      "description": "生成 GB/T 7714 规范三线表，含字母上标和统计文字",
      "endpoint": "/api/table",
      "input_type": "json",
      "example": "{\"groups\":[{\"label\":\"处理A\",\"n\":30,\"mean\":12.3,\"sd\":1.2},{\"label\":\"处理B\",\"n\":30,\"mean\":15.7,\"sd\":0.9}],\"anova\":{\"F\":8.43,\"df1\":2,\"df2\":87,\"p\":0.0004},\"posthoc\":[{\"pair\":[\"A\",\"B\"],\"p\":0.023}]}",
      "config_fields": [
        {"key": "title", "label": "表标题", "type": "text"}
      ]
    }
  ]
}
