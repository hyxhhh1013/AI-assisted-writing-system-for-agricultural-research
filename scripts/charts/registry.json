    {
      "id": "diagram",
      "name": "示意图",
      "icon": "Workflow",
      "order": 2
    },
    {
      "id": "xrd",
      "name": "XRD / Jade",
      "icon": "Radar",
      "order": 3
    },
    {
      "id": "dft",
      "name": "DFT 计算",
      "icon": "Atom",
      "order": 4
